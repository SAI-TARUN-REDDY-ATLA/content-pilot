# Copy to .env and fill in. .env is git-ignored and loaded automatically.

# Gemini API key from https://aistudio.google.com/apikey (needed for everything except --script)
GOOGLE_API_KEY=

# YouTube, only for --upload. Run `content-pilot-auth client_secret.json` once to get these.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional overrides
# CONTENT_PILOT_MODEL=google_genai:gemini-3.7-flash
# CONTENT_PILOT_PRIVACY=public
# CONTENT_PILOT_VOICE=en-US-ChristopherNeural
# CONTENT_PILOT_VOICE_RATE=+12%
# CONTENT_PILOT_FOOTAGE=assets/footage
# CONTENT_PILOT_FONT=/path/to/BoldFont.ttf
