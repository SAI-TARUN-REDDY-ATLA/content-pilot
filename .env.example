# Copy to .env and fill in. .env is git-ignored and loaded automatically.

# Gemini API key from https://aistudio.google.com/apikey (needed for everything except --placeholder-art).
# Enable billing on its Google Cloud project: the image model has no free tier.
GOOGLE_API_KEY=

# YouTube, only for --upload. Run `content-pilot-auth client_secret.json` once to get these.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional overrides
# CONTENT_PILOT_MINUTES=5
# CONTENT_PILOT_MODEL=google_genai:gemini-3.7-flash
# CONTENT_PILOT_IMAGE_MODEL=gemini-2.5-flash-image
# CONTENT_PILOT_ART_STYLE=Flat 2D cartoon illustration ...
# CONTENT_PILOT_PRIVACY=public
# CONTENT_PILOT_VOICE=en-US-AndrewNeural
# CONTENT_PILOT_VOICE_RATE=+0%
# CONTENT_PILOT_MUSIC=assets/music
# CONTENT_PILOT_MUSIC_VOLUME=0.10
# CONTENT_PILOT_FONT=/path/to/BoldFont.ttf
